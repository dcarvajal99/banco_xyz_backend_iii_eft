# Variables secretas del docker-compose.yaml. Copiar a .env (no se versiona) y cambiar los valores en un despliegue real.
# Sin .env, el compose usa estos mismos valores de desarrollo.

# Config Server (Basic, ademas del certificado de cliente de cada servicio)
BANCO_CONFIG_USUARIO=configuracion
BANCO_CONFIG_CLAVE=config-secreto-dev
# Clave de los almacenes PKCS12 que genera la imagen pki
BANCO_ALMACEN_CLAVE=almacen-dev
# Base de datos
BANCO_DB_USUARIO=banco
BANCO_DB_CLAVE=banco123
# Canal AUTENTICACION: banco-auth verifica las claves de los clientes contra el core
BANCO_CANAL_AUTENTICACION_CLAVE=autenticacion-secreto-dev
# Secretos de los clientes OAuth 2.0 registrados en banco-auth (se guardan con bcrypt)
BANCO_OAUTH_BANCA_WEB_SECRETO=banca-web-secreto-dev
BANCO_OAUTH_TRANSFERENCIAS_SECRETO=transferencias-oauth-dev
# Cliente operacion-banco: el unico que puede rotar y retirar las claves de firma (/actuator/claves)
BANCO_OAUTH_OPERACION_SECRETO=operacion-secreto-dev
# Inicio de sesion con GitHub: aplicacion OAuth registrada en GitHub (Settings > Developer settings > OAuth Apps) con
# Authorization callback URL https://localhost:8081/login/oauth2/code/github. Sin estos valores, el login solo ofrece
# usuario y clave.
BANCO_GITHUB_CLIENT_ID=sin-configurar
BANCO_GITHUB_CLIENT_SECRET=sin-configurar
# Para entrar con OTRA cuenta de GitHub, vincularla a un cliente del banco: id numerico de GitHub=usuario del banco
# (varios separados por coma). El id se ve en https://api.github.com/users/<login> o en el log de banco-auth al rechazarla.
BANCO_GITHUB_VINCULOS=
